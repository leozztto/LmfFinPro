# Postgres
POSTGRES_DB=finpro
POSTGRES_USER=finpro
POSTGRES_PASSWORD=finpro

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finpro
SPRING_DATASOURCE_USERNAME=finpro
SPRING_DATASOURCE_PASSWORD=finpro
# Obrigatório, mínimo 32 bytes; a aplicação não sobe sem ele. Gere com: openssl rand -base64 48
JWT_SECRET=
# Access token curto (15 min); a sessão longa vem do refresh token em cookie httpOnly (30 dias, renovado a cada uso).
JWT_EXPIRATION_MS=900000
# Cookie Secure só trafega por HTTPS (localhost é exceção). Use false apenas em HTTP fora de localhost.
REFRESH_COOKIE_SECURE=true
# Opcionais: validade do refresh token em dias (padrão 30) e rate limit das rotas públicas de auth (padrão true).
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger UI (/swagger-ui.html) e /v3/api-docs: desligados por padrão. Use true só em desenvolvimento.
SWAGGER_ENABLED=true

# Redefinição de senha ("esqueci minha senha")
# FRONTEND_URL monta o link enviado por e-mail (<FRONTEND_URL>/redefinir-senha?token=...)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MAIL_FROM=FinPro <no-reply@finpro.local>
# SMTP — sem SPRING_MAIL_HOST o link só vai para o log do backend.
# Com o Mailpit do docker-compose (docker compose up -d mailpit): host localhost, porta 1025.
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
